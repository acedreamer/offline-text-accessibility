<cell id="cell-13"><cell_type>markdown</cell_type>## Step 7 — Accessibility Scoring Functions

We score each sentence pair based on accessibility features:

**Scoring components:**
- Sentence length (< 15 words = better)
- Word frequency (common words = easier)
- Concreteness (concrete words = better for autism)
- Simplification ratio (degree of change)</cell id="cell-13">

<cell id="cell-14">import nltk
from collections import Counter
from typing import List


def word_frequency_score(text: str) -> float:
    """
    Score based on word frequency (higher = more common words = easier).
    Uses word length as proxy (shorter words = more frequent).
    """
    words = nltk.word_tokenize(text.lower())
    words = [w for w in words if w.isalpha()]

    if not words:
        return 0.0

    # Heuristic: shorter average word length = higher frequency
    avg_length = sum(len(w) for w in words) / len(words)
    length_score = max(0, 10 - avg_length) / 10

    # Bonus for stopwords (very common)
    try:
        from nltk.corpus import stopwords
        stopword_count = sum(1 for w in words if w in stopwords.words('english'))
        if stopword_count > len(words) * 0.3:
            length_score += 0.1
        length_score = min(1.0, length_score)
    except:
        pass

    return length_score


def sentence_length_score(text: str) -> float:
    """
    Score based on sentence length (shorter = better for ADHD/dyslexia).
    Returns 1.0 for < 10 words, 0.0 for > 25 words.
    """
    words = text.split()
    length = len(words)

    if length <= 10:
        return 1.0
    elif length <= 15:
        return 0.8
    elif length <= 20:
        return 0.5
    elif length <= 25:
        return 0.2
    else:
        return 0.0


def concreteness_score(text: str) -> float:
    """
    Estimate concreteness based on part-of-speech tags.
    Nouns (concrete) = 0.8, Verbs = 0.5, Adjectives/Adverbs = 0.3
    """
    try:
        words = nltk.word_tokenize(text.lower())
        words = [w for w in words if w.isalpha()]

        if not words:
            return 0.0

        pos_tags = nltk.pos_tag(words)

        # POS-based scoring
        scores = []
        for word, pos in pos_tags:
            if pos.startswith('NN'):  # Nouns
                score = 0.8
            elif pos.startswith('VB'):  # Verbs
                score = 0.5
            elif pos.startswith('JJ') or pos.startswith('RB'):  # Adj/Adv
                score = 0.3
            else:
                score = 0.4

            # Long words penalty
            if len(word) > 10:
                score -= 0.2

            scores.append(max(0.0, score))

        return sum(scores) / len(scores)
    except Exception as e:
        print(f"Warning: Concreteness scoring failed: {e}")
        return 0.5  # Neutral fallback


def calculate_accessibility_score(example: dict) -> dict:
    """
    Calculate combined accessibility score for a (src, tgt) pair.

    Weighted score:
    - Sentence length: 40%
    - Word frequency: 30%
    - Concreteness: 20%
    - Simplification ratio: 10%

    Returns: accessibility_score (0.0 to 1.0)
    """
    src = example['src']
    tgt = example['tgt']

    src_words = src.split()
    tgt_words = tgt.split()

    if not src_words or not tgt_words:
        example['accessibility_score'] = 0.0
        return example

    # 1. Sentence length score (40%)
    length_score = sentence_length_score(tgt)

    # 2. Word frequency score (30%)
    freq_score = word_frequency_score(tgt)

    # 3. Concreteness score (20%)
    concrete_score = concreteness_score(tgt)

    # 4. Simplification ratio (10%)
    if len(tgt_words) >= len(src_words):
        simplification_score = 0.0
    elif len(tgt_words) < len(src_words) * 0.5:
        simplification_score = 0.5  # Over-simplified
    else:
        simplification_score = 1.0 - (len(tgt_words) / len(src_words))

    # Combined score
    total_score = (
        length_score * 0.4 +
        freq_score * 0.3 +
        concrete_score * 0.2 +
        simplification_score * 0.1
    )

    example['accessibility_score'] = total_score
    return example


print("Testing accessibility scoring...")
test_cases = [
    {"src": "The individual proceeded to traverse the thoroughfare", "tgt": "The person crossed the street"},
    {"src": "Comprehensive analysis indicates significant ramifications", "tgt": "Study shows big effects"},
    {"src": "The cat sat on the mat", "tgt": "The cat sat"},  # Too simple
