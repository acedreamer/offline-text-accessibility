<cell id="cell-25"><cell_type>markdown</cell_type>## Step 13 — Define accessibility evaluation metrics

Custom metrics to track accessibility improvements during training.</cell id="cell-25">

<cell id="cell-26"># Initialize evaluation metrics
print("Loading evaluation metrics...")

try:
    from evaluate import load
    rouge_metric = load("rouge")
    print("✅ ROUGE metric loaded")
except Exception as e:
    print(f"⚠ ROUGE load failed: {e}")
    print("Installing evaluate...")
    !pip install -q evaluate
    from evaluate import load
    rouge_metric = load("rouge")


def compute_accessibility_metrics(eval_preds):
    """
    Custom evaluation: Standard ROUGE + Accessibility metrics.
    Returns:
    - ROUGE (standard simplification metric)
    - Sentence length (shorter = better accessibility)
    - Word frequency (common words = easier)
    - Concreteness (literal words = better for autism)
    """
    predictions, labels = eval_preds

    # Decode predictions
    decoded_preds = tokenizer.batch_decode(predictions, skip_special_tokens=True)

    # Decode labels (replace -100 padding token)
    labels_processed = [
        [t if t != -100 else tokenizer.pad_token_id for t in label]
        for label in labels
    ]
    decoded_refs = tokenizer.batch_decode(labels_processed, skip_special_tokens=True)

    # Initialize metrics
    result = {}

    # ROUGE (standard metric)
    if rouge_metric:
        rouge_scores = rouge_metric.compute(
            predictions=decoded_preds,
            references=decoded_refs,
            use_stemmer=True
        )
        result.update(rouge_scores)

    # Accessibility metrics
    len_scores, freq_scores, concrete_scores = [], [], []

    for pred in decoded_preds:
        len_scores.append(sentence_length_score(pred))
        freq_scores.append(word_frequency_score(pred))
        concrete_scores.append(concreteness_score(pred))

    result['sentence_length'] = sum(len_scores) / len(len_scores)
    result['word_frequency'] = sum(freq_scores) / len(freq_scores)
    result['concreteness'] = sum(concrete_scores) / len(concrete_scores)

    # Combined accessibility score
    result['accessibility_score'] = (
        result['sentence_length'] * 0.4 +
        result['word_frequency'] * 0.3 +
        result['concreteness'] * 0.2
    )

    return result


# Custom trainer class
class AccessibilityTrainer(Seq2SeqTrainer):
    def compute_metrics(self, eval_preds):
        return compute_accessibility_metrics(eval_preds)


# Create trainer
print("\nCreating trainer...")
trainer = AccessibilityTrainer(
    model=model,
    args=training_args,
    train_dataset=tokenized_train,
    eval_dataset=tokenized_val,
    tokenizer=tokenizer,
    data_collator=data_collator,
)

print("✅ Trainer ready!")
print(f"   Train size: {len(tokenized_train):,}")
print(f"   Val size: {len(tokenized_val):,}")
print(f"   Device: {model.device}")
