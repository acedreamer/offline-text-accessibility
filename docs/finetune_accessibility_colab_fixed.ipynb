   "source": [
    "## Step 5 — Standardize dataset format\n",
    "\n",
    "Different datasets have different column names. We standardize to:\n",
    "- `src` (complex/source text)\n",
    "- `tgt` (simplified/target text)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-10",
   "metadata": {},
   "outputs": [],
   "source": [
    "def standardize_format(dataset, dataset_name):\n",
    "    \"\"\"Convert various dataset formats to standard format.\"\"\"\n",
    "\n",
    "    def map_function(example):\n",
    "        try:\n",
    "            if dataset_name == \"wiki_auto\":\n",
    "                # WikiAuto uses \"source\" and \"target\"\n",
    "                return {\"src\": example[\"source\"], \"tgt\": example[\"target\"]}\n",
    "            elif dataset_name == \"asset\":\n",
    "                # Asset has \"original\" and multiple simplifications\n",
    "                # We take the first (they're ordered by simplicity)\n",
    "                return {\"src\": example[\"original\"], \"tgt\": example[\"simplifications\"][0]}\n",
    "            else:\n",
    "                # Try common column names\n",
    "                src_key = tgt_key = None\n",
    "                for key in example.keys():\n",
    "                    key_lower = key.lower()\n",
    "                    if key_lower in [\"complex\", \"original\", \"source\", \"normal\", \"src\"]:\n",
    "                        src_key = key\n",
    "                    elif key_lower in [\"simple\", \"simplified\", \"target\", \"tgt\"]:\n",
    "                        tgt_key = key\n",
    "\n",
    "                if src_key and tgt_key:\n",
    "                    return {\"src\": example[src_key], \"tgt\": example[tgt_key]}\n",
    "\n    "                print(f\"Warning: Could not find src/tgt in {example.keys()}\")\n",
    "                return None\n",
    "        except Exception as e:\n",
    "            print(f\"Error mapping {dataset_name} example: {e}\")\n",
    "            return None\n",
    "    \n",
    "    return dataset.map(map_function, remove_columns=dataset.column_names)\n",
    "\n",
    "print(\"Standardizing dataset formats...\")\n",
    "standardized_datasets = []\n",
    "\n",
    "for name, dataset in loaded_datasets.items():\n",
    "    try:\n",
    "        print(f\"  Processing {name}...\")\n",
    "        standardized = standardize_format(dataset, name)\n",
    "        if standardized and len(standardized) > 0:\n",
    "            standardized_datasets.append(standardized)\n",
    "            print(f\"    ✓ Standardized {len(standardized)} examples\")\n",
    "        else:\n",
    "            print(f\"    ⚠ No valid examples after standardization\")\n",
    "    except Exception as e:\n",
    "        print(f\"    ⚠ Error standardizing {name}: {e}\")\n",
    "\n",
    "print(f\"\\n✅ Standardized {len(standardized_datasets)} dataset(s)\")"
   ]
